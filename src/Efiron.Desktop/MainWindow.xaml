<Window
    x:Class="Efiron.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Efiron.Desktop.Views"
    mc:Ignorable="d">

  <Grid
      x:Name="WindowRoot"
      Background="{ThemeResource EfironWindowBrush}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F11" Invoked="FullscreenKeyboardAccelerator_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="ExitFullscreenKeyboardAccelerator_Invoked" />
    </Grid.KeyboardAccelerators>

    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="TitleBarDragRegion"
        Padding="12,0"
        Background="{ThemeResource EfironNavigationBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border
            Width="26"
            Height="26"
            Background="{ThemeResource EfironAccentBrush}"
            CornerRadius="8">
          <FontIcon
              Glyph="&#xE768;"
              FontSize="14"
              Foreground="White"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
        </Border>
        <TextBlock
            Text="EFIRON"
            FontFamily="Segoe UI Variable Display"
            FontSize="15"
            FontWeight="Bold"
            CharacterSpacing="45"
            Foreground="{ThemeResource EfironTextBrush}"
            VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock
          x:Name="WindowContextTitle"
          Grid.Column="1"
          x:Uid="WindowContextTitle"
          Margin="24,0,0,0"
          Style="{StaticResource EfironCaptionStyle}"
          VerticalAlignment="Center" />
    </Grid>

    <ScrollViewer
        x:Name="SourcesWorkspace"
        Grid.Row="1"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <Grid
          x:Name="SourcesContentGrid"
          MaxWidth="1120"
          Margin="42,34,42,48"
          HorizontalAlignment="Stretch"
          RowSpacing="20"
          SizeChanged="SourcesContentGrid_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="7">
            <TextBlock
                x:Uid="SourcesTitle"
                Style="{StaticResource EfironPageTitleStyle}" />
            <TextBlock
                x:Uid="SourcesDescription"
                MaxWidth="760"
                Style="{StaticResource EfironBodyStyle}"
                TextWrapping="Wrap" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Padding="12,7"
              Background="{ThemeResource EfironSurfaceRaisedBrush}"
              BorderBrush="{ThemeResource EfironStrokeBrush}"
              BorderThickness="1"
              CornerRadius="18"
              VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse
                  x:Name="ConfigurationStatusDot"
                  Width="8"
                  Height="8"
                  Fill="{ThemeResource EfironTextTertiaryBrush}"
                  VerticalAlignment="Center" />
              <TextBlock
                  x:Name="ConfigurationStatusText"
                  x:Uid="ConfigurationStatusLoading"
                  Style="{StaticResource EfironCaptionStyle}"
                  FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>

        <InfoBar
            x:Name="PageMessage"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid
            x:Name="SourceCardsGrid"
            Grid.Row="2"
            ColumnSpacing="18"
            RowSpacing="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SourceCardsFirstColumn" Width="*" />
            <ColumnDefinition x:Name="SourceCardsSecondColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="SourceCardsSecondRow" Height="0" />
          </Grid.RowDefinitions>

          <Border x:Name="PlaylistSourceCard" Style="{StaticResource EfironCardStyle}">
            <Grid RowSpacing="15">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="42"
                    Height="42"
                    Background="{ThemeResource EfironAccentSubtleBrush}"
                    CornerRadius="11">
                  <FontIcon
                      Glyph="&#xE8A5;"
                      FontSize="19"
                      Foreground="{ThemeResource EfironAccentBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock
                      x:Uid="PlaylistCardTitle"
                      Style="{StaticResource EfironSectionTitleStyle}" />
                  <TextBlock
                      x:Uid="PlaylistCardDescription"
                      Style="{StaticResource EfironCaptionStyle}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <TextBox
                  x:Name="PlaylistLocationTextBox"
                  Grid.Row="1"
                  x:Uid="PlaylistLocation"
                  MinHeight="42" />
              <TextBlock
                  Grid.Row="2"
                  x:Uid="PlaylistHelp"
                  Style="{StaticResource EfironCaptionStyle}"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Border
              x:Name="GuideSourceCard"
              Grid.Column="1"
              Style="{StaticResource EfironCardStyle}">
            <Grid RowSpacing="15">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="42"
                    Height="42"
                    Background="{ThemeResource EfironAccentSubtleBrush}"
                    CornerRadius="11">
                  <FontIcon
                      Glyph="&#xE787;"
                      FontSize="19"
                      Foreground="{ThemeResource EfironAccentBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock
                      x:Uid="GuideCardTitle"
                      Style="{StaticResource EfironSectionTitleStyle}" />
                  <TextBlock
                      x:Uid="GuideCardDescription"
                      Style="{StaticResource EfironCaptionStyle}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <TextBox
                  x:Name="GuideLocationTextBox"
                  Grid.Row="1"
                  x:Uid="GuideLocation"
                  MinHeight="42" />
              <TextBlock
                  Grid.Row="2"
                  x:Uid="GuideHelp"
                  Style="{StaticResource EfironCaptionStyle}"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource EfironCardStyle}">
          <Grid x:Name="StorageCardGrid" ColumnSpacing="18" RowSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition x:Name="StorageActionColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="StorageActionRow" Height="0" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="5">
              <TextBlock
                  x:Uid="StorageTitle"
                  Style="{StaticResource EfironSectionTitleStyle}" />
              <TextBlock
                  x:Uid="StorageDescription"
                  Style="{StaticResource EfironBodyStyle}"
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="ConfigurationPathText"
                  Margin="0,5,0,0"
                  Style="{StaticResource EfironCaptionStyle}"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                x:Name="StorageActionPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
              <ProgressRing
                  x:Name="SaveProgressRing"
                  Width="24"
                  Height="24"
                  IsActive="False"
                  Visibility="Collapsed" />
              <Button
                  x:Name="SaveSourcesButton"
                  x:Uid="SaveSourcesButton"
                  Click="SaveSourcesButton_Click" />
              <Button
                  x:Name="OpenLiveButton"
                  x:Uid="OpenLiveButton"
                  Style="{StaticResource EfironPrimaryButtonStyle}"
                  IsEnabled="False"
                  Click="OpenLiveButton_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource EfironCardStyle}">
          <Grid RowSpacing="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                  Width="42"
                  Height="42"
                  Background="{ThemeResource EfironAccentSubtleBrush}"
                  CornerRadius="11">
                <FontIcon
                    Glyph="&#xE790;"
                    FontSize="19"
                    Foreground="{ThemeResource EfironAccentBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock
                    x:Uid="AppearanceTitle"
                    Style="{StaticResource EfironSectionTitleStyle}" />
                <TextBlock
                    x:Uid="AppearanceDescription"
                    Style="{StaticResource EfironCaptionStyle}"
                    TextWrapping="Wrap" />
              </StackPanel>
              <Border
                  x:Name="AccentPreview"
                  Grid.Column="2"
                  Width="34"
                  Height="34"
                  Background="{ThemeResource EfironAccentBrush}"
                  CornerRadius="17"
                  VerticalAlignment="Center" />
            </Grid>

            <Grid
                x:Name="AppearanceOptionsGrid"
                Grid.Row="1"
                ColumnSpacing="18"
                RowSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AppearanceSecondColumn" Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="AppearanceSecondRow" Height="0" />
              </Grid.RowDefinitions>
              <StackPanel x:Name="ThemeOptionPanel" Spacing="7">
                <TextBlock x:Uid="AppearanceThemeLabel" Style="{StaticResource EfironCaptionStyle}" />
                <ComboBox
                    x:Name="ThemeComboBox"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="AppearanceComboBox_SelectionChanged" />
              </StackPanel>
              <StackPanel
                  x:Name="AccentOptionPanel"
                  Grid.Column="1"
                  Spacing="7">
                <TextBlock x:Uid="AppearanceAccentLabel" Style="{StaticResource EfironCaptionStyle}" />
                <ComboBox
                    x:Name="AccentComboBox"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="AppearanceComboBox_SelectionChanged" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <TextBlock
            Grid.Row="5"
            x:Uid="NextStepCaption"
            Style="{StaticResource EfironCaptionStyle}"
            TextWrapping="Wrap" />
      </Grid>
    </ScrollViewer>

    <views:LiveTvView
        x:Name="LiveTvWorkspace"
        Grid.Row="1"
        Visibility="Collapsed" />
  </Grid>
</Window>
