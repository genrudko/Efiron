<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Efiron.Desktop</RootNamespace>
    <AssemblyName>Efiron</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>en-US;ru-RU</SatelliteResourceLanguages>
    <LibMpvRuntimeDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\libmpv\win-x64</LibMpvRuntimeDirectory>
    <LibMpvRuntimeDll>$(LibMpvRuntimeDirectory)\libmpv-2.dll</LibMpvRuntimeDll>
    <LibMpvRuntimeManifest>$(LibMpvRuntimeDirectory)\runtime-manifest.json</LibMpvRuntimeManifest>
    <MpvHostRuntimeDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\mpv-host\win-x64</MpvHostRuntimeDirectory>
    <MpvHostRuntimeExe>$(MpvHostRuntimeDirectory)\mpv.exe</MpvHostRuntimeExe>
    <MpvHostRuntimeManifest>$(MpvHostRuntimeDirectory)\runtime-manifest.json</MpvHostRuntimeManifest>
    <MpvHostRuntimeNotice>$(MpvHostRuntimeDirectory)\NOTICE.txt</MpvHostRuntimeNotice>
    <FlyleafFfmpegRuntimeDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\flyleaf-ffmpeg\win-x64</FlyleafFfmpegRuntimeDirectory>
    <FlyleafFfmpegRuntimeManifest>$(FlyleafFfmpegRuntimeDirectory)\runtime-manifest.json</FlyleafFfmpegRuntimeManifest>
    <FlyleafFfmpegRuntimeNotice>$(FlyleafFfmpegRuntimeDirectory)\NOTICE.txt</FlyleafFfmpegRuntimeNotice>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlyleafLib.Controls.WinUI" />
    <PackageReference Include="LibVLCSharp.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Efiron.Application\Efiron.Application.csproj" />
    <ProjectReference Include="..\Efiron.Domain\Efiron.Domain.csproj" />
    <ProjectReference Include="..\Efiron.Infrastructure\Efiron.Infrastructure.csproj" />
    <ProjectReference Include="..\Efiron.Playback\Efiron.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MpvHostRuntimeExe)">
      <Link>mpv-host\mpv.exe</Link>
      <TargetPath>mpv-host\mpv.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MpvHostRuntimeManifest)">
      <Link>mpv-host\runtime-manifest.json</Link>
      <TargetPath>mpv-host\runtime-manifest.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MpvHostRuntimeNotice)">
      <Link>mpv-host\NOTICE.txt</Link>
      <TargetPath>mpv-host\NOTICE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareDesktopLibMpvRuntime" BeforeTargets="PrepareForBuild">
    <Exec
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\prepare-libmpv-runtime.ps1&quot; -OutputDirectory &quot;$(LibMpvRuntimeDirectory)&quot;" />
    <Error
        Condition="!Exists('$(LibMpvRuntimeDll)')"
        Text="Pinned libmpv runtime was not prepared: $(LibMpvRuntimeDll)" />
    <ItemGroup>
      <ContentWithTargetPath Include="$(LibMpvRuntimeDll)">
        <TargetPath>libmpv-2.dll</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(LibMpvRuntimeManifest)">
        <TargetPath>libmpv-runtime-manifest.json</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>

  <Target Name="PrepareDesktopMpvHostRuntime" BeforeTargets="PrepareForBuild">
    <Exec
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\prepare-mpv-host-runtime.ps1&quot; -OutputDirectory &quot;$(MpvHostRuntimeDirectory)&quot;" />
    <Error
        Condition="!Exists('$(MpvHostRuntimeExe)')"
        Text="Pinned mpv host runtime was not prepared: $(MpvHostRuntimeExe)" />
    <Error
        Condition="!Exists('$(MpvHostRuntimeManifest)')"
        Text="Pinned mpv host runtime manifest was not prepared: $(MpvHostRuntimeManifest)" />
    <Error
        Condition="!Exists('$(MpvHostRuntimeNotice)')"
        Text="Pinned mpv host provenance notice was not prepared: $(MpvHostRuntimeNotice)" />
  </Target>

  <Target Name="PrepareDesktopFlyleafFfmpegRuntime" BeforeTargets="PrepareForBuild">
    <Exec
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\prepare-flyleaf-ffmpeg-runtime.ps1&quot; -OutputDirectory &quot;$(FlyleafFfmpegRuntimeDirectory)&quot;" />
    <Error
        Condition="!Exists('$(FlyleafFfmpegRuntimeDirectory)\avcodec-62.dll')"
        Text="Pinned Flyleaf FFmpeg runtime was not prepared." />
    <Error
        Condition="!Exists('$(FlyleafFfmpegRuntimeManifest)')"
        Text="Pinned Flyleaf FFmpeg runtime manifest was not prepared." />
    <Error
        Condition="!Exists('$(FlyleafFfmpegRuntimeNotice)')"
        Text="Pinned Flyleaf FFmpeg runtime notice was not prepared." />
  </Target>

  <Target
      Name="VerifyDesktopMpvHostRuntimeOutput"
      AfterTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(TargetDir)mpv-host" />
    <Copy
        SourceFiles="$(MpvHostRuntimeExe);$(MpvHostRuntimeManifest);$(MpvHostRuntimeNotice)"
        DestinationFiles="$(TargetDir)mpv-host\mpv.exe;$(TargetDir)mpv-host\runtime-manifest.json;$(TargetDir)mpv-host\NOTICE.txt"
        SkipUnchangedFiles="true" />
    <Error
        Condition="!Exists('$(TargetDir)mpv-host\mpv.exe')"
        Text="Desktop output is missing the mpv host executable." />
    <Error
        Condition="!Exists('$(TargetDir)mpv-host\runtime-manifest.json')"
        Text="Desktop output is missing the mpv host runtime manifest." />
    <Error
        Condition="!Exists('$(TargetDir)mpv-host\NOTICE.txt')"
        Text="Desktop output is missing the mpv host provenance notice." />
  </Target>

  <Target
      Name="VerifyDesktopFlyleafFfmpegRuntimeOutput"
      AfterTargets="CopyFilesToOutputDirectory"
      DependsOnTargets="PrepareDesktopFlyleafFfmpegRuntime">
    <ItemGroup>
      <FlyleafFfmpegRuntimeDlls Include="$(FlyleafFfmpegRuntimeDirectory)\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)FFmpeg" />
    <Copy
        SourceFiles="@(FlyleafFfmpegRuntimeDlls)"
        DestinationFolder="$(TargetDir)FFmpeg"
        SkipUnchangedFiles="true" />
    <Copy
        SourceFiles="$(FlyleafFfmpegRuntimeManifest);$(FlyleafFfmpegRuntimeNotice)"
        DestinationFiles="$(TargetDir)FFmpeg\runtime-manifest.json;$(TargetDir)FFmpeg\NOTICE.txt"
        SkipUnchangedFiles="true" />
    <Error
        Condition="'@(FlyleafFfmpegRuntimeDlls)' == ''"
        Text="Desktop output has no Flyleaf FFmpeg runtime DLLs." />
    <Error
        Condition="!Exists('$(TargetDir)FFmpeg\avcodec-62.dll') or !Exists('$(TargetDir)FFmpeg\avformat-62.dll') or !Exists('$(TargetDir)FFmpeg\avutil-60.dll')"
        Text="Desktop output is missing required Flyleaf FFmpeg components." />
    <Error
        Condition="!Exists('$(TargetDir)FFmpeg\runtime-manifest.json') or !Exists('$(TargetDir)FFmpeg\NOTICE.txt')"
        Text="Desktop output is missing Flyleaf FFmpeg provenance files." />
  </Target>

  <Target
      Name="VerifyDesktopMpvHostRuntimePublish"
      AfterTargets="Publish"
      Condition="'$(PublishDir)' != ''">
    <MakeDir Directories="$(PublishDir)mpv-host" />
    <Copy
        SourceFiles="$(MpvHostRuntimeExe);$(MpvHostRuntimeManifest);$(MpvHostRuntimeNotice)"
        DestinationFiles="$(PublishDir)mpv-host\mpv.exe;$(PublishDir)mpv-host\runtime-manifest.json;$(PublishDir)mpv-host\NOTICE.txt"
        SkipUnchangedFiles="true" />
    <Error
        Condition="!Exists('$(PublishDir)mpv-host\mpv.exe')"
        Text="Desktop publish output is missing the mpv host executable." />
  </Target>

  <Target
      Name="VerifyDesktopFlyleafFfmpegRuntimePublish"
      AfterTargets="Publish"
      Condition="'$(PublishDir)' != ''"
      DependsOnTargets="PrepareDesktopFlyleafFfmpegRuntime">
    <ItemGroup>
      <FlyleafFfmpegPublishDlls Include="$(FlyleafFfmpegRuntimeDirectory)\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)FFmpeg" />
    <Copy
        SourceFiles="@(FlyleafFfmpegPublishDlls)"
        DestinationFolder="$(PublishDir)FFmpeg"
        SkipUnchangedFiles="true" />
    <Copy
        SourceFiles="$(FlyleafFfmpegRuntimeManifest);$(FlyleafFfmpegRuntimeNotice)"
        DestinationFiles="$(PublishDir)FFmpeg\runtime-manifest.json;$(PublishDir)FFmpeg\NOTICE.txt"
        SkipUnchangedFiles="true" />
    <Error
        Condition="!Exists('$(PublishDir)FFmpeg\avcodec-62.dll')"
        Text="Desktop publish output is missing the Flyleaf FFmpeg runtime." />
  </Target>
</Project>
