<Application
    x:Class="Efiron.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="EfironWindowBrush" Color="#070B11" />
          <SolidColorBrush x:Key="EfironNavigationBrush" Color="#0B1018" />
          <SolidColorBrush x:Key="EfironSurfaceBrush" Color="#0F1620" />
          <SolidColorBrush x:Key="EfironSurfaceRaisedBrush" Color="#151E2A" />
          <SolidColorBrush x:Key="EfironSurfaceHoverBrush" Color="#1B2735" />
          <SolidColorBrush x:Key="EfironStrokeBrush" Color="#243142" />
          <SolidColorBrush x:Key="EfironStrokeSubtleBrush" Color="#182331" />
          <SolidColorBrush x:Key="EfironTextBrush" Color="#F7F9FC" />
          <SolidColorBrush x:Key="EfironTextSecondaryBrush" Color="#AEB8C7" />
          <SolidColorBrush x:Key="EfironTextTertiaryBrush" Color="#748095" />
          <SolidColorBrush x:Key="EfironAccentBrush" Color="#2586FF" />
          <SolidColorBrush x:Key="EfironAccentHoverBrush" Color="#3C94FF" />
          <SolidColorBrush x:Key="EfironAccentSubtleBrush" Color="#2D2586FF" />
          <SolidColorBrush x:Key="EfironAccentQuietBrush" Color="#152586FF" />
          <SolidColorBrush x:Key="EfironSuccessBrush" Color="#36C78B" />
          <SolidColorBrush x:Key="EfironWarningBrush" Color="#F0B84B" />
          <SolidColorBrush x:Key="EfironDangerBrush" Color="#E25858" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EfironWindowBrush" Color="#EEF2F7" />
          <SolidColorBrush x:Key="EfironNavigationBrush" Color="#F9FBFD" />
          <SolidColorBrush x:Key="EfironSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EfironSurfaceRaisedBrush" Color="#F5F8FC" />
          <SolidColorBrush x:Key="EfironSurfaceHoverBrush" Color="#EAF0F7" />
          <SolidColorBrush x:Key="EfironStrokeBrush" Color="#D2DBE7" />
          <SolidColorBrush x:Key="EfironStrokeSubtleBrush" Color="#E3E9F0" />
          <SolidColorBrush x:Key="EfironTextBrush" Color="#101722" />
          <SolidColorBrush x:Key="EfironTextSecondaryBrush" Color="#4D5A6C" />
          <SolidColorBrush x:Key="EfironTextTertiaryBrush" Color="#7A8797" />
          <SolidColorBrush x:Key="EfironAccentBrush" Color="#126FDB" />
          <SolidColorBrush x:Key="EfironAccentHoverBrush" Color="#2580E8" />
          <SolidColorBrush x:Key="EfironAccentSubtleBrush" Color="#24126FDB" />
          <SolidColorBrush x:Key="EfironAccentQuietBrush" Color="#10126FDB" />
          <SolidColorBrush x:Key="EfironSuccessBrush" Color="#12865A" />
          <SolidColorBrush x:Key="EfironWarningBrush" Color="#A96D00" />
          <SolidColorBrush x:Key="EfironDangerBrush" Color="#B93636" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <LinearGradientBrush x:Key="EfironBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C8CFF" Offset="0" />
        <GradientStop Color="#8558F6" Offset="0.52" />
        <GradientStop Color="#F15D96" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="EfironVideoOverlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.35" />
        <GradientStop Color="#B0000000" Offset="0.78" />
        <GradientStop Color="#F0000000" Offset="1" />
      </LinearGradientBrush>

      <Style x:Key="EfironPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextBrush}" />
      </Style>

      <Style x:Key="EfironSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextBrush}" />
      </Style>

      <Style x:Key="EfironBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextSecondaryBrush}" />
      </Style>

      <Style x:Key="EfironCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextTertiaryBrush}" />
      </Style>

      <Style x:Key="EfironEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="75" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextTertiaryBrush}" />
      </Style>

      <Style x:Key="EfironCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EfironSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EfironStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
      </Style>

      <Style x:Key="EfironPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource EfironAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="EfironSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource EfironSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EfironStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,8" />
      </Style>

      <Style x:Key="EfironIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EfironSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EfironStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <Style x:Key="EfironNavigationToggleStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border
                  x:Name="NavigationRoot"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
                <Grid>
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal" />
                      <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                          <Setter Target="NavigationRoot.Background" Value="{ThemeResource EfironSurfaceHoverBrush}" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                          <Setter Target="NavigationRoot.Background" Value="{ThemeResource EfironSurfaceRaisedBrush}" />
                          <Setter Target="NavigationRoot.Opacity" Value="0.88" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                          <Setter Target="NavigationRoot.Opacity" Value="0.45" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CheckStates">
                      <VisualState x:Name="Unchecked" />
                      <VisualState x:Name="Checked">
                        <VisualState.Setters>
                          <Setter Target="NavigationRoot.Background" Value="{ThemeResource EfironAccentQuietBrush}" />
                          <Setter Target="NavigationIndicator.Background" Value="{ThemeResource EfironAccentBrush}" />
                          <Setter Target="NavigationContent.Foreground" Value="{ThemeResource EfironTextBrush}" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Indeterminate">
                        <VisualState.Setters>
                          <Setter Target="NavigationRoot.Background" Value="{ThemeResource EfironAccentQuietBrush}" />
                          <Setter Target="NavigationIndicator.Background" Value="{ThemeResource EfironAccentBrush}" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border
                      x:Name="NavigationIndicator"
                      Width="3"
                      Margin="0,7"
                      Background="Transparent"
                      CornerRadius="2" />
                  <ContentPresenter
                      x:Name="NavigationContent"
                      Grid.Column="1"
                      Padding="{TemplateBinding Padding}"
                      Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Foreground="{TemplateBinding Foreground}"
                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="EfironCategoryItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="7" />
      </Style>

      <Style x:Key="EfironChannelItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="CornerRadius" Value="9" />
      </Style>

      <Style x:Key="EfironPillToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{ThemeResource EfironSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EfironTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EfironStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="17" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>