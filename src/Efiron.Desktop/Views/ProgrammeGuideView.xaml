<UserControl
    x:Class="Efiron.Desktop.Views.ProgrammeGuideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:Efiron.Desktop.Presentation"
    mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="EpgListItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="EpgProgrammeButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{ThemeResource EfironAccentQuietBrush}" />
      <Setter Property="Foreground" Value="{ThemeResource EfironTextBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource EfironStrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="4" />
    </Style>

    <Style x:Key="EpgCanvasContainerStyle" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding Left}" />
    </Style>
  </UserControl.Resources>

  <Grid
      x:Name="ProgrammeRoot"
      Padding="30,24,30,28"
      RowSpacing="14"
      Background="{ThemeResource EfironWindowBrush}"
      KeyDown="ProgrammeRoot_KeyDown"
      SizeChanged="ProgrammeRoot_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="4">
        <TextBlock Text="ПРОГРАММА" Style="{StaticResource EfironEyebrowStyle}" />
        <TextBlock Text="Телепрограмма" Style="{StaticResource EfironPageTitleStyle}" />
        <TextBlock
            x:Name="ProgrammeSummaryText"
            Text="Расписание каналов на выбранный день"
            Style="{StaticResource EfironBodyStyle}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Style="{StaticResource EfironIconButtonStyle}" Click="PreviousDayButton_Click" ToolTipService.ToolTip="Предыдущий день">
          <FontIcon Glyph="&#xE76B;" FontSize="15" />
        </Button>
        <Border
            MinWidth="154"
            Padding="14,8"
            Background="{ThemeResource EfironSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource EfironStrokeSubtleBrush}"
            BorderThickness="1"
            CornerRadius="9">
          <TextBlock
              x:Name="SelectedDateText"
              HorizontalAlignment="Center"
              Style="{StaticResource EfironBodyStyle}"
              FontWeight="SemiBold" />
        </Border>
        <Button Style="{StaticResource EfironIconButtonStyle}" Click="NextDayButton_Click" ToolTipService.ToolTip="Следующий день">
          <FontIcon Glyph="&#xE76C;" FontSize="15" />
        </Button>
        <Button
            x:Name="JumpNowButton"
            Content="Сейчас"
            Style="{StaticResource EfironPrimaryButtonStyle}"
            Click="JumpNowButton_Click" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox
          x:Name="ProgrammeSearchTextBox"
          PlaceholderText="Канал или передача"
          TextChanged="ProgrammeSearchTextBox_TextChanged">
        <TextBox.HeaderTemplate>
          <DataTemplate><TextBlock Text="Поиск" /></DataTemplate>
        </TextBox.HeaderTemplate>
      </TextBox>

      <ComboBox
          x:Name="ProgrammeCategoryComboBox"
          Grid.Column="1"
          Header="Категория"
          HorizontalAlignment="Stretch"
          SelectionChanged="ProgrammeCategoryComboBox_SelectionChanged" />

      <Border
          Grid.Column="2"
          Padding="12,8"
          Background="{ThemeResource EfironSurfaceRaisedBrush}"
          BorderBrush="{ThemeResource EfironStrokeSubtleBrush}"
          BorderThickness="1"
          CornerRadius="9"
          VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="{ThemeResource EfironSuccessBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="VisibleChannelCountText" Style="{StaticResource EfironCaptionStyle}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <Border
        Grid.Row="2"
        Background="{ThemeResource EfironSurfaceBrush}"
        BorderBrush="{ThemeResource EfironStrokeSubtleBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Clip="{x:Null}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="EpgChannelColumn" Width="252" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Padding="16,0"
            Background="{ThemeResource EfironNavigationBrush}"
            BorderBrush="{ThemeResource EfironStrokeSubtleBrush}"
            BorderThickness="0,0,1,1">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" Style="{StaticResource EfironCaptionStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Канал" Style="{StaticResource EfironCaptionStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ScrollViewer
            x:Name="TimelineHeaderScrollViewer"
            Grid.Column="1"
            HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Hidden"
            ZoomMode="Disabled"
            IsHitTestVisible="False">
          <Grid x:Name="TimelineHeaderGrid" Height="54" Background="{ThemeResource EfironNavigationBrush}" />
        </ScrollViewer>

        <ListView
            x:Name="ChannelRowsListView"
            Grid.Row="1"
            ItemsSource="{x:Bind _visibleRows, Mode=OneWay}"
            ItemContainerStyle="{StaticResource EpgListItemStyle}"
            IsItemClickEnabled="True"
            ItemClick="ChannelRowsListView_ItemClick"
            SelectionMode="None"
            Loaded="ChannelRowsListView_Loaded">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="presentation:EpgChannelRowItem">
              <Grid Height="72" Padding="12,0" ColumnSpacing="10" BorderBrush="{ThemeResource EfironStrokeSubtleBrush}" BorderThickness="0,0,1,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Number}" Style="{StaticResource EfironCaptionStyle}" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Center">
                  <Border Background="{ThemeResource EfironAccentQuietBrush}" CornerRadius="9">
                    <TextBlock Text="{x:Bind Initials}" Foreground="{ThemeResource EfironAccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Image Source="{x:Bind LogoUrl, Mode=OneWay}" Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource EfironTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Category}" Style="{StaticResource EfironCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="TimelineViewportGrid" Grid.Row="1" Grid.Column="1" SizeChanged="TimelineViewportGrid_SizeChanged">
          <ScrollViewer
              x:Name="TimelineHorizontalScrollViewer"
              HorizontalScrollMode="Enabled"
              HorizontalScrollBarVisibility="Visible"
              VerticalScrollMode="Disabled"
              VerticalScrollBarVisibility="Hidden"
              ZoomMode="Disabled"
              ViewChanged="TimelineHorizontalScrollViewer_ViewChanged">
            <ListView
                x:Name="TimelineRowsListView"
                ItemsSource="{x:Bind _visibleRows, Mode=OneWay}"
                ItemContainerStyle="{StaticResource EpgListItemStyle}"
                SelectionMode="None"
                Loaded="TimelineRowsListView_Loaded">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="presentation:EpgChannelRowItem">
                  <Grid Height="72" Width="{x:Bind TimelineWidth}" Background="{ThemeResource EfironSurfaceBrush}" BorderBrush="{ThemeResource EfironStrokeSubtleBrush}" BorderThickness="0,0,0,1">
                    <ItemsControl
                        ItemsSource="{x:Bind Programmes}"
                        ItemContainerStyle="{StaticResource EpgCanvasContainerStyle}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:EpgProgrammeBlockItem">
                          <Button
                              Width="{x:Bind Width}"
                              Height="64"
                              Margin="1,4,1,4"
                              Style="{StaticResource EpgProgrammeButtonStyle}"
                              Tag="{Binding}"
                              Click="ProgrammeButton_Click">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                              </Grid.RowDefinitions>
                              <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Visibility="{x:Bind CurrentBadgeVisibility}"
                                    Padding="5,1"
                                    Background="{ThemeResource EfironAccentBrush}"
                                    CornerRadius="5">
                                  <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{StaticResource EfironCaptionStyle}" TextTrimming="CharacterEllipsis" />
                              </Grid>
                              <TextBlock Grid.Row="1" Text="{x:Bind Title}" Foreground="{ThemeResource EfironTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </ScrollViewer>

          <Canvas IsHitTestVisible="False">
            <Border x:Name="CurrentTimeLine" Width="2" Background="{ThemeResource EfironDangerBrush}" Visibility="Collapsed">
              <Border.Shadow>
                <ThemeShadow />
              </Border.Shadow>
            </Border>
          </Canvas>
        </Grid>

        <Grid
            x:Name="ProgrammeEmptyState"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="{ThemeResource EfironSurfaceBrush}"
            Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE787;" FontSize="30" Foreground="{ThemeResource EfironTextTertiaryBrush}" />
            <TextBlock Text="Для выбранного фильтра нет каналов" Style="{StaticResource EfironSectionTitleStyle}" />
            <TextBlock Text="Измените категорию или поисковый запрос" Style="{StaticResource EfironBodyStyle}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border
        x:Name="ProgrammeDetailsCard"
        Grid.Row="3"
        Padding="16,14"
        Background="{ThemeResource EfironSurfaceRaisedBrush}"
        BorderBrush="{ThemeResource EfironStrokeSubtleBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Visibility="Collapsed">
      <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock x:Name="DetailsTimeText" Style="{StaticResource EfironCaptionStyle}" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailsChannelText" Style="{StaticResource EfironCaptionStyle}" />
          </StackPanel>
          <TextBlock x:Name="DetailsTitleText" Style="{StaticResource EfironSectionTitleStyle}" />
          <TextBlock x:Name="DetailsDescriptionText" MaxWidth="900" Style="{StaticResource EfironBodyStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button
            x:Name="PlayProgrammeChannelButton"
            Grid.Column="1"
            Content="Смотреть канал"
            Style="{StaticResource EfironPrimaryButtonStyle}"
            Click="PlayProgrammeChannelButton_Click"
            VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
