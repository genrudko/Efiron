  <data name="PlaylistHelp.Text" xml:space="preserve"><value>HTTP/HTTPS URLs, file URIs and local paths are supported. Size and content are validated before a catalog is built.</value></data>
  <data name="GuideCardTitle.Text" xml:space="preserve"><value>TV guide</value></data>
  <data name="GuideCardDescription.Text" xml:space="preserve"><value>XMLTV or XMLTV.GZ programme data</value></data>
