  <data name="WindowTitle" xml:space="preserve"><value>Efiron — Sources</value></data>
  <data name="WindowContextTitle.Text" xml:space="preserve"><value>Initial setup</value></data>
  <data name="ShellProductSubtitle.Text" xml:space="preserve"><value>New Efiron</value></data>
  <data name="ShellProductDescription.Text" xml:space="preserve"><value>Clean architecture without the legacy interface</value></data>
  <data name="NavigationSettings.Text" xml:space="preserve"><value>SETTINGS</value></data>
  <data name="NavigationSources.Text" xml:space="preserve"><value>Sources</value></data>
