<Window
    x:Class="Efiron.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <NavigationView
      x:Name="RootNavigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="True"
      PaneDisplayMode="Auto"
      SelectionChanged="RootNavigation_SelectionChanged">

    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="LiveNavigationItem" x:Uid="NavigationLive" Icon="Play" Tag="live" />
      <NavigationViewItem x:Uid="NavigationGuide" Icon="Calendar" Tag="guide" />
      <NavigationViewItem x:Uid="NavigationArchive" Icon="Clock" Tag="archive" />
      <NavigationViewItem x:Uid="NavigationRecordings" Icon="Video" Tag="recordings" />
    </NavigationView.MenuItems>

    <NavigationView.Header>
      <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
    </NavigationView.Header>

    <Grid Padding="24,12,24,24">
      <Grid x:Name="LiveView">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="Black" CornerRadius="8">
          <Grid x:Name="LivePlayerHost">
            <lvs:VideoView x:Name="VideoView" />
            <TextBlock
                x:Name="PlayerEmptyState"
                x:Uid="PlayerEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                TextAlignment="Center"
                TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="SourceTextBox" x:Uid="PlayerSource" />
          <Button Grid.Column="1" x:Uid="PlayerPlay" Click="PlayButton_Click" />
          <Button Grid.Column="2" x:Uid="PlayerPause" Click="PauseButton_Click" />
          <Button Grid.Column="3" x:Uid="PlayerStop" Click="StopButton_Click" />
        </Grid>
      </Grid>

      <ScrollViewer x:Name="GuideView" Visibility="Collapsed">
        <StackPanel Spacing="16">
          <TextBlock x:Uid="GuideIntro" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE787;" FontSize="28" />
                <TextBlock x:Uid="GuideGridTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="GuideGridDescription" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE8FD;" FontSize="28" />
                <TextBlock x:Uid="GuideListTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="GuideListDescription" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE823;" FontSize="28" />
                <TextBlock x:Uid="GuideNowTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="GuideNowDescription" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
          <InfoBar x:Uid="GuideArchiveInfo" IsOpen="True" Severity="Informational" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel x:Name="ArchiveView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="ArchiveIntro" TextWrapping="Wrap" />
        <InfoBar x:Uid="ArchiveProviderInfo" IsOpen="True" Severity="Informational" />
      </StackPanel>

      <StackPanel x:Name="RecordingsView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="RecordingsIntro" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel x:Name="SettingsView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="SettingsLanguageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Uid="SettingsLanguageDescription" TextWrapping="Wrap" />
        <ComboBox x:Name="LanguageComboBox" x:Uid="SettingsLanguageSelector" SelectionChanged="LanguageComboBox_SelectionChanged">
          <ComboBoxItem Content="Русский" Tag="ru-RU" />
          <ComboBoxItem Content="English" Tag="en-US" />
        </ComboBox>
        <InfoBar x:Name="RestartInfoBar" x:Uid="SettingsRestartInfo" IsOpen="False" Severity="Informational" />
      </StackPanel>
    </Grid>

    <NavigationView.FooterMenuItems>
      <NavigationViewItem IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE946;" />
          <TextBlock x:Name="StatusText" />
        </StackPanel>
      </NavigationViewItem>
    </NavigationView.FooterMenuItems>
  </NavigationView>
</Window>
