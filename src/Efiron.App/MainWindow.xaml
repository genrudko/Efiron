<Window
    x:Class="Efiron.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <NavigationView
      x:Name="RootNavigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="True"
      PaneDisplayMode="Auto"
      SelectionChanged="RootNavigation_SelectionChanged">

    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="LiveNavigationItem" x:Uid="NavigationLive" Icon="Play" Tag="live" />
      <NavigationViewItem x:Uid="NavigationGuide" Icon="Calendar" Tag="guide" />
      <NavigationViewItem x:Uid="NavigationArchive" Icon="Clock" Tag="archive" />
      <NavigationViewItem x:Uid="NavigationRecordings" Icon="Video" Tag="recordings" />
    </NavigationView.MenuItems>

    <NavigationView.Header>
      <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
    </NavigationView.Header>

    <Grid Padding="24,12,24,24">
      <Grid x:Name="LiveView" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
          <Grid RowSpacing="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
              <TextBlock x:Uid="PlaylistSourceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PlaylistSourceTextBox" x:Uid="PlaylistSource" />
                <Button
                    x:Name="LoadPlaylistButton"
                    Grid.Column="1"
                    x:Uid="PlaylistLoad"
                    Click="LoadPlaylistButton_Click" />
                <ProgressRing
                    x:Name="PlaylistProgressRing"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    IsActive="False"
                    Visibility="Collapsed" />
              </Grid>
              <InfoBar
                  x:Name="PlaylistInfoBar"
                  IsClosable="True"
                  IsOpen="False" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ChannelSearchTextBox"
                    x:Uid="ChannelSearch"
                    TextChanged="ChannelSearchTextBox_TextChanged" />
                <ComboBox
                    x:Name="GroupFilterComboBox"
                    Grid.Column="1"
                    x:Uid="GroupFilter"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="GroupFilterComboBox_SelectionChanged" />
              </Grid>
              <TextBlock
                  x:Name="PlaylistSummaryText"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="2">
              <ListView
                  x:Name="ChannelListView"
                  IsItemClickEnabled="True"
                  ItemClick="ChannelListView_ItemClick"
                  SelectionMode="Single">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="4,8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock
                          Text="{Binding Name}"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Grid.Row="1"
                          Text="{Binding GroupDisplayName}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock
                  x:Name="ChannelEmptyState"
                  x:Uid="ChannelEmptyState"
                  Margin="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </Grid>

            <Expander Grid.Row="3" x:Name="DirectStreamExpander" x:Uid="DirectStreamExpander">
              <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourceTextBox" x:Uid="PlayerSource" />
                <Button Grid.Column="1" x:Uid="PlayerPlay" Click="PlayButton_Click" />
              </Grid>
            </Expander>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
              x:Name="SelectedChannelText"
              x:Uid="SelectedChannelEmpty"
              Style="{StaticResource SubtitleTextBlockStyle}"
              TextTrimming="CharacterEllipsis" />

          <Border Grid.Row="1" Background="Black" CornerRadius="8">
            <Grid x:Name="LivePlayerHost">
              <lvs:VideoView x:Name="VideoView" />
              <TextBlock
                  x:Name="PlayerEmptyState"
                  x:Uid="PlayerEmptyState"
                  Margin="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="White"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>

          <StackPanel
              Grid.Row="2"
              HorizontalAlignment="Right"
              Orientation="Horizontal"
              Spacing="8">
            <Button x:Uid="PlayerPause" Click="PauseButton_Click" />
            <Button x:Uid="PlayerStop" Click="StopButton_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="GuideView" Visibility="Collapsed" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
          <StackPanel Spacing="8">
            <TextBlock x:Uid="EpgSourceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="EpgSourceTextBox" x:Uid="EpgSource" />
              <Button
                  x:Name="LoadEpgButton"
                  Grid.Column="1"
                  x:Uid="EpgLoad"
                  Click="LoadEpgButton_Click" />
              <ProgressRing
                  x:Name="EpgProgressRing"
                  Grid.Column="2"
                  Width="24"
                  Height="24"
                  IsActive="False"
                  Visibility="Collapsed" />
            </Grid>
            <TextBlock
                x:Name="EpgSummaryText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar
                x:Name="EpgInfoBar"
                IsClosable="True"
                IsOpen="False" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
              x:Name="GuideChannelComboBox"
              x:Uid="GuideChannelSelector"
              DisplayMemberPath="Name"
              HorizontalAlignment="Stretch"
              SelectionChanged="GuideChannelComboBox_SelectionChanged" />
          <Button
              Grid.Column="1"
              x:Uid="GuidePreviousDay"
              Click="GuidePreviousDayButton_Click" />
          <CalendarDatePicker
              x:Name="GuideDatePicker"
              Grid.Column="2"
              x:Uid="GuideDateSelector"
              DateChanged="GuideDatePicker_DateChanged" />
          <Button
              Grid.Column="3"
              x:Uid="GuideToday"
              Click="GuideTodayButton_Click" />
          <Button
              Grid.Column="4"
              x:Uid="GuideNextDay"
              Click="GuideNextDayButton_Click" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border
              Padding="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <Grid>
              <ListView
                  x:Name="ProgrammeListView"
                  SelectionChanged="ProgrammeListView_SelectionChanged"
                  SelectionMode="Single">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          Text="{Binding TimeRange}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="{Binding Title}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Subtitle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Categories}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <TextBlock
                  x:Name="ProgrammeEmptyState"
                  x:Uid="ProgrammeEmptyState"
                  Margin="24"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Border
              Grid.Column="1"
              Padding="20"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
            <ScrollViewer>
              <StackPanel Spacing="10">
                <TextBlock x:Uid="ProgrammeDetailsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="ProgrammeDetailsTime"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="ProgrammeDetailsName"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ProgrammeDetailsSubtitle"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ProgrammeDetailsCategories"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ProgrammeDetailsDescription"
                    TextWrapping="WrapWholeWords" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <StackPanel x:Name="ArchiveView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="ArchiveIntro" TextWrapping="Wrap" />
        <InfoBar x:Uid="ArchiveProviderInfo" IsOpen="True" Severity="Informational" />
      </StackPanel>

      <StackPanel x:Name="RecordingsView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="RecordingsIntro" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel x:Name="SettingsView" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Uid="SettingsLanguageTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Uid="SettingsLanguageDescription" TextWrapping="Wrap" />
        <ComboBox x:Name="LanguageComboBox" x:Uid="SettingsLanguageSelector" SelectionChanged="LanguageComboBox_SelectionChanged">
          <ComboBoxItem Content="Русский" Tag="ru-RU" />
          <ComboBoxItem Content="English" Tag="en-US" />
        </ComboBox>
        <InfoBar x:Name="RestartInfoBar" x:Uid="SettingsRestartInfo" IsOpen="False" Severity="Informational" />
      </StackPanel>
    </Grid>

    <NavigationView.FooterMenuItems>
      <NavigationViewItem IsEnabled="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE946;" />
          <TextBlock x:Name="StatusText" />
        </StackPanel>
      </NavigationViewItem>
    </NavigationView.FooterMenuItems>
  </NavigationView>
</Window>
