<Window
    x:Class="Efiron.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Efiron.App.Views"
    mc:Ignorable="d">

  <Grid
      x:Name="WindowRoot"
      Background="{StaticResource EfironAppBackgroundBrush}">
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        IsPaneOpen="True"
        OpenPaneLength="220"
        CompactPaneLength="52"
        AlwaysShowHeader="False"
        KeyDown="RootNavigation_KeyDown"
        Loaded="RootNavigation_Loaded"
        Unloaded="RootNavigation_Unloaded"
        SelectionChanged="RootNavigation_SelectionChanged">

      <NavigationView.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="FullscreenKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="ExitFullscreenKeyboardAccelerator_Invoked" />
      </NavigationView.KeyboardAccelerators>

      <NavigationView.PaneHeader>
        <Grid Margin="2,4,8,12" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border
              Width="32"
              Height="32"
              Background="{StaticResource EfironAccentBrush}"
              CornerRadius="9">
            <FontIcon
                Glyph="&#xE768;"
                Foreground="{StaticResource EfironAccentForegroundBrush}"
                FontSize="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
            <TextBlock
                Text="EFIRON"
                FontFamily="Segoe UI Variable Display"
                FontSize="19"
                FontWeight="Bold"
                CharacterSpacing="45" />
            <TextBlock
                x:Uid="ShellProductSubtitle"
                Style="{StaticResource EfironCaptionTextStyle}"
                FontSize="10" />
          </StackPanel>
        </Grid>
      </NavigationView.PaneHeader>

      <NavigationView.MenuItems>
        <NavigationViewItem
            x:Name="LiveNavigationItem"
            x:Uid="NavigationLive"
            Icon="Play"
            Tag="live" />
        <NavigationViewItem
            x:Name="GuideNavigationItem"
            x:Uid="NavigationGuide"
            Icon="Calendar"
            Tag="guide"
            IsEnabled="False" />
        <NavigationViewItem
            x:Name="ArchiveNavigationItem"
            x:Uid="NavigationArchive"
            Icon="Clock"
            Tag="archive"
            IsEnabled="False" />
        <NavigationViewItem
            x:Name="RecordingsNavigationItem"
            x:Uid="NavigationRecordings"
            Icon="Video"
            Tag="recordings"
            IsEnabled="False" />
        <NavigationViewItem
            x:Name="ChannelsNavigationItem"
            x:Uid="NavigationChannels"
            Tag="channels"
            IsEnabled="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8B7;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.FooterMenuItems>
        <NavigationViewItem
            x:Name="SettingsNavigationItem"
            x:Uid="NavigationSettings"
            Tag="settings"
            IsEnabled="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
            x:Name="StatusNavigationItem"
            Visibility="Collapsed"
            IsEnabled="False">
          <TextBlock x:Name="StatusText" />
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid
          x:Name="ContentRoot"
          Padding="8"
          Background="{StaticResource EfironAppBackgroundBrush}">
        <views:LiveTvView x:Name="LiveScreen" />

        <!--
          Temporary compatibility bridge for retained parser/player/EPG code.
          It is never visible and does not participate in the new presentation geometry.
        -->
        <Grid
            x:Name="CompatibilityBridge"
            Visibility="Collapsed">
          <TextBlock x:Name="HeaderTitle" />

          <TextBox x:Name="PlaylistSourceTextBox" />
          <Button x:Name="LoadPlaylistButton" Click="LoadPlaylistButton_Click" />
          <ProgressRing x:Name="PlaylistProgressRing" />
          <InfoBar x:Name="PlaylistInfoBar" />
          <ComboBox x:Name="GroupFilterComboBox" />

          <TextBox x:Name="EpgSourceTextBox" />
          <Button x:Name="LoadEpgButton" Click="LoadEpgButton_Click" />
          <ProgressRing x:Name="EpgProgressRing" />
          <TextBlock x:Name="EpgSummaryText" />
          <InfoBar x:Name="EpgInfoBar" />

          <TextBox x:Name="SourceTextBox" />

          <Grid x:Name="GuideView" Visibility="Collapsed">
            <ComboBox
                x:Name="GuideChannelComboBox"
                DisplayMemberPath="Name"
                SelectionChanged="GuideChannelComboBox_SelectionChanged" />
            <CalendarDatePicker
                x:Name="GuideDatePicker"
                DateChanged="GuideDatePicker_DateChanged" />
            <ListView
                x:Name="ProgrammeListView"
                SelectionChanged="ProgrammeListView_SelectionChanged" />
            <TextBlock x:Name="ProgrammeEmptyState" />
            <TextBlock x:Name="ProgrammeDetailsTime" />
            <TextBlock x:Name="ProgrammeDetailsName" />
            <TextBlock x:Name="ProgrammeDetailsSubtitle" />
            <TextBlock x:Name="ProgrammeDetailsCategories" />
            <TextBlock x:Name="ProgrammeDetailsDescription" />
          </Grid>

          <StackPanel x:Name="ArchiveView" Visibility="Collapsed" />
          <StackPanel x:Name="RecordingsView" Visibility="Collapsed" />
          <StackPanel x:Name="SettingsView" Visibility="Collapsed">
            <ComboBox
                x:Name="LanguageComboBox"
                SelectionChanged="LanguageComboBox_SelectionChanged">
              <ComboBoxItem Content="Русский" Tag="ru-RU" />
              <ComboBoxItem Content="English" Tag="en-US" />
            </ComboBox>
            <InfoBar x:Name="RestartInfoBar" />
          </StackPanel>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
