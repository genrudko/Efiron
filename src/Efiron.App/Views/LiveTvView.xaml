<UserControl
    x:Class="Efiron.App.Views.LiveTvView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="LiveCategoryItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="LiveChannelItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="68" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </UserControl.Resources>

  <Grid
      x:Name="RootGrid"
      ColumnSpacing="8"
      Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="CategoryColumn" Width="176" />
      <ColumnDefinition x:Name="ChannelColumn" Width="288" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border
        x:Name="CategorySurface"
        Style="{StaticResource EfironCompactSurfaceBorderStyle}">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon
              Glyph="&#xE8B7;"
              FontSize="16"
              Foreground="{StaticResource EfironAccentBrush}" />
          <TextBlock
              Grid.Column="1"
              x:Uid="LiveCategoriesTitle"
              Style="{StaticResource EfironSectionTitleTextStyle}"
              FontSize="15"
              VerticalAlignment="Center" />
        </Grid>

        <ListView
            x:Name="CategoryListView"
            Grid.Row="1"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource LiveCategoryItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Padding="9,7" ColumnSpacing="9">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Glyph="{Binding Glyph}"
                    FontSize="14"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Name}"
                    Style="{StaticResource EfironBodyTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding CountText}"
                    Style="{StaticResource EfironCaptionTextStyle}"
                    VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <Border
        x:Name="ChannelSurface"
        Grid.Column="1"
        Style="{StaticResource EfironCompactSurfaceBorderStyle}">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
              x:Name="ChannelSearchTextBox"
              x:Uid="LiveChannelSearch"
              MinHeight="34" />
          <Button
              x:Name="SourceSetupButton"
              Grid.Column="1"
              x:Uid="LiveSourceSetup"
              Style="{StaticResource EfironIconButtonStyle}"
              Width="36"
              Height="36">
            <FontIcon Glyph="&#xE774;" FontSize="15" />
          </Button>
        </Grid>

        <TextBlock
            x:Name="ChannelSummaryText"
            Grid.Row="1"
            Style="{StaticResource EfironCaptionTextStyle}" />

        <Grid Grid.Row="2">
          <ListView
              x:Name="ChannelListView"
              IsItemClickEnabled="True"
              SelectionMode="Single"
              ItemContainerStyle="{StaticResource LiveChannelItemStyle}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="7,6" ColumnSpacing="7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                  </Grid.ColumnDefinitions>

                  <TextBlock
                      Text="{Binding NumberText}"
                      Style="{StaticResource EfironCaptionTextStyle}"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

                  <Grid Grid.Column="1" Width="36" Height="36">
                    <Border
                        Background="{StaticResource EfironSubtleSurfaceBrush}"
                        BorderBrush="{StaticResource EfironStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                      <TextBlock
                          Text="{Binding LogoFallback}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold" />
                    </Border>
                    <Image
                        Source="{Binding LogoImage}"
                        Stretch="Uniform"
                        Margin="3" />
                  </Grid>

                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding DisplayName}"
                        Style="{StaticResource EfironChannelTitleTextStyle}"
                        FontSize="14"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{Binding CurrentProgrammeTitle}"
                        Style="{StaticResource EfironCaptionTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{Binding CurrentProgrammeTime}"
                        Style="{StaticResource EfironCaptionTextStyle}"
                        FontSize="10"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding FavoriteGlyph}"
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{StaticResource EfironFavoriteBrush}"
                        FontSize="14"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding PlayingGlyph}"
                        FontFamily="Segoe Fluent Icons"
                        Foreground="{StaticResource EfironLiveBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel
              x:Name="ChannelEmptyState"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="8"
              IsHitTestVisible="False">
            <FontIcon
                Glyph="&#xE8B7;"
                FontSize="28"
                Foreground="{StaticResource EfironTextTertiaryBrush}" />
            <TextBlock
                x:Uid="LiveChannelEmpty"
                MaxWidth="210"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Style="{StaticResource EfironCaptionTextStyle}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Grid
        x:Name="LivePlayerGrid"
        Grid.Column="2"
        RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition x:Name="NowNextRow" Height="Auto" />
        <RowDefinition x:Name="MessageRow" Height="Auto" />
        <RowDefinition x:Name="ActionsRow" Height="Auto" />
      </Grid.RowDefinitions>

      <Border
          x:Name="PlayerSurfaceBorder"
          Background="Black"
          BorderBrush="{StaticResource EfironStrokeBrush}"
          BorderThickness="1"
          CornerRadius="10">
        <Grid
            x:Name="LivePlayerHost"
            Background="Black">
          <lvs:VideoView x:Name="PlayerVideoView" />

          <Grid
              x:Name="PlayerInputSurface"
              Background="Transparent" />

          <Border
              x:Name="PlayerHeaderOverlay"
              Margin="16"
              Padding="12,9"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="#B8121720"
              CornerRadius="8"
              Visibility="Collapsed">
            <StackPanel Spacing="2">
              <TextBlock
                  x:Name="SelectedChannelText"
                  Foreground="White"
                  FontSize="20"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  x:Name="PlayerProgrammeText"
                  Foreground="#D9FFFFFF"
                  FontSize="12"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <StackPanel
              x:Name="WelcomePanel"
              Width="440"
              MaxWidth="640"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="12">
            <FontIcon
                Glyph="&#xE768;"
                FontSize="46"
                Foreground="{StaticResource EfironAccentBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Uid="LiveWelcomeTitle"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"
                TextAlignment="Center" />
            <TextBlock
                x:Uid="LiveWelcomeDescription"
                Foreground="#C8FFFFFF"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="WelcomeSourceButton"
                x:Uid="LiveWelcomeAction"
                Style="{StaticResource EfironPrimaryButtonStyle}"
                HorizontalAlignment="Center" />
          </StackPanel>

          <TextBlock
              x:Name="PlayerEmptyState"
              x:Uid="LivePlayerEmpty"
              Margin="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="#D9FFFFFF"
              IsHitTestVisible="False"
              TextAlignment="Center"
              TextWrapping="Wrap"
              Visibility="Collapsed" />

          <ProgressRing
              x:Name="PlayerOpeningIndicator"
              Width="48"
              Height="48"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsActive="False"
              IsHitTestVisible="False"
              Visibility="Collapsed" />

          <Border
              x:Name="PlayerControlOverlay"
              Margin="12"
              Padding="9"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Background="#D6121720"
              CornerRadius="8">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button
                  x:Name="PlayerPlayPauseButton"
                  x:Uid="LivePlayPause"
                  Width="38"
                  Height="38"
                  Padding="0"
                  Style="{StaticResource EfironPrimaryButtonStyle}">
                <FontIcon x:Name="PlayerPlayPauseIcon" Glyph="&#xE768;" FontSize="17" />
              </Button>

              <Button
                  x:Name="PlayerStopControlButton"
                  Grid.Column="1"
                  x:Uid="LiveStop"
                  Width="38"
                  Height="38"
                  Padding="0">
                <FontIcon Glyph="&#xE71A;" FontSize="16" />
              </Button>

              <TextBlock
                  x:Name="PlayerStatusText"
                  Grid.Column="2"
                  Margin="4,0,8,0"
                  VerticalAlignment="Center"
                  Foreground="White"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis" />

              <Button
                  x:Name="PlayerMuteButton"
                  Grid.Column="3"
                  x:Uid="LiveMute"
                  Width="38"
                  Height="38"
                  Padding="0">
                <FontIcon x:Name="PlayerMuteIcon" Glyph="&#xE767;" FontSize="17" />
              </Button>

              <Slider
                  x:Name="VolumeSlider"
                  Grid.Column="4"
                  x:Uid="LiveVolume"
                  Minimum="0"
                  Maximum="100"
                  StepFrequency="1"
                  Value="100"
                  VerticalAlignment="Center" />

              <TextBlock
                  x:Name="VolumeValueText"
                  Grid.Column="5"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="100%"
                  TextAlignment="Right" />

              <Button
                  x:Name="PlayerFullscreenButton"
                  Grid.Column="6"
                  x:Uid="LiveFullscreen"
                  Width="38"
                  Height="38"
                  Padding="0">
                <FontIcon x:Name="PlayerFullscreenIcon" Glyph="&#xE740;" FontSize="17" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border
          x:Name="NowNextPanel"
          Grid.Row="1"
          Style="{StaticResource EfironCompactSurfaceBorderStyle}">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Spacing="3">
            <TextBlock
                x:Uid="LiveNowLabel"
                Style="{StaticResource EfironCaptionTextStyle}"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="NowTitleText"
                Style="{StaticResource EfironProgrammeTitleTextStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="NowTimeText"
                Style="{StaticResource EfironCaptionTextStyle}" />
            <ProgressBar
                x:Name="NowProgressBar"
                Minimum="0"
                Maximum="100"
                Value="0"
                Style="{StaticResource EfironAccentProgressBarStyle}" />
            <TextBlock
                x:Name="NowCategoriesText"
                Style="{StaticResource EfironCaptionTextStyle}"
                TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <Border
              Grid.Column="1"
              Padding="14,0,0,0"
              BorderBrush="{StaticResource EfironStrokeBrush}"
              BorderThickness="1,0,0,0">
            <StackPanel Spacing="3">
              <TextBlock
                  x:Uid="LiveNextLabel"
                  Style="{StaticResource EfironCaptionTextStyle}"
                  FontWeight="SemiBold" />
              <TextBlock
                  x:Name="NextTitleText"
                  Style="{StaticResource EfironProgrammeTitleTextStyle}"
                  TextTrimming="CharacterEllipsis" />
              <TextBlock
                  x:Name="NextTimeText"
                  Style="{StaticResource EfironCaptionTextStyle}" />
              <TextBlock
                  x:Name="NextCategoriesText"
                  Style="{StaticResource EfironCaptionTextStyle}"
                  TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <InfoBar
          x:Name="LiveInfoBar"
          Grid.Row="2"
          IsClosable="True"
          IsOpen="False" />

      <Grid Grid.Row="3" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="FocusChannelsButton"
            x:Uid="LiveActionChannels">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
            <TextBlock x:Uid="LiveActionChannelsText" />
          </StackPanel>
        </Button>

        <Button
            x:Name="FavoriteActionButton"
            Grid.Column="1"
            x:Uid="LiveActionFavorite">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon x:Name="FavoriteActionIcon" Glyph="&#xE734;" FontSize="14" />
            <TextBlock x:Name="FavoriteActionText" x:Uid="LiveActionFavoriteText" />
          </StackPanel>
        </Button>

        <Button
            x:Name="ProgrammeInfoButton"
            Grid.Column="2"
            x:Uid="LiveActionProgramme">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="&#xE946;" FontSize="14" />
            <TextBlock x:Uid="LiveActionProgrammeText" />
          </StackPanel>
        </Button>

        <Button
            x:Name="ArchiveActionButton"
            Grid.Column="3"
            x:Uid="LiveActionArchive">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="&#xE823;" FontSize="14" />
            <TextBlock x:Uid="LiveActionArchiveText" />
          </StackPanel>
        </Button>

        <ProgressRing
            x:Name="SourceLoadingRing"
            Grid.Column="5"
            Width="28"
            Height="28"
            IsActive="False"
            Visibility="Collapsed"
            VerticalAlignment="Center" />

        <Button
            x:Name="MoreActionButton"
            Grid.Column="6"
            x:Uid="LiveActionMore"
            Style="{StaticResource EfironIconButtonStyle}"
            Width="36"
            Height="36">
          <FontIcon Glyph="&#xE712;" FontSize="15" />
        </Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
