<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LibMpvRuntimeDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\libmpv\win-x64</LibMpvRuntimeDirectory>
    <LibMpvRuntimeDll>$(LibMpvRuntimeDirectory)\libmpv-2.dll</LibMpvRuntimeDll>
    <LibMpvRuntimeManifest>$(LibMpvRuntimeDirectory)\runtime-manifest.json</LibMpvRuntimeManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Efiron.Playback\Efiron.Playback.csproj" />
  </ItemGroup>

  <Target Name="PrepareProbeLibMpvRuntime" BeforeTargets="PrepareForBuild">
    <Exec
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\prepare-libmpv-runtime.ps1&quot; -OutputDirectory &quot;$(LibMpvRuntimeDirectory)&quot;" />
    <Error
        Condition="!Exists('$(LibMpvRuntimeDll)')"
        Text="Pinned libmpv runtime was not prepared: $(LibMpvRuntimeDll)" />
    <ItemGroup>
      <ContentWithTargetPath Include="$(LibMpvRuntimeDll)">
        <TargetPath>libmpv-2.dll</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(LibMpvRuntimeManifest)">
        <TargetPath>libmpv-runtime-manifest.json</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
