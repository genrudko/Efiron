<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <MpvHostRuntimeDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\mpv-host\win-x64</MpvHostRuntimeDirectory>
    <MpvHostRuntimeExe>$(MpvHostRuntimeDirectory)\mpv.exe</MpvHostRuntimeExe>
    <MpvHostRuntimeManifest>$(MpvHostRuntimeDirectory)\runtime-manifest.json</MpvHostRuntimeManifest>
    <MpvHostRuntimeNotice>$(MpvHostRuntimeDirectory)\NOTICE.txt</MpvHostRuntimeNotice>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Efiron.Application\Efiron.Application.csproj" />
    <ProjectReference Include="..\..\src\Efiron.Domain\Efiron.Domain.csproj" />
    <ProjectReference Include="..\..\src\Efiron.Playback\Efiron.Playback.csproj" />
  </ItemGroup>

  <Target Name="PrepareProbeMpvHostRuntime" BeforeTargets="PrepareForBuild">
    <Exec
        Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\prepare-mpv-host-runtime.ps1&quot; -OutputDirectory &quot;$(MpvHostRuntimeDirectory)&quot;" />
    <Error
        Condition="!Exists('$(MpvHostRuntimeExe)')"
        Text="Pinned mpv host runtime was not prepared: $(MpvHostRuntimeExe)" />
    <Error
        Condition="!Exists('$(MpvHostRuntimeNotice)')"
        Text="Pinned mpv host provenance notice was not prepared: $(MpvHostRuntimeNotice)" />
    <ItemGroup>
      <ContentWithTargetPath Include="$(MpvHostRuntimeExe)">
        <TargetPath>mpv-host\mpv.exe</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(MpvHostRuntimeManifest)">
        <TargetPath>mpv-host\runtime-manifest.json</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="$(MpvHostRuntimeNotice)">
        <TargetPath>mpv-host\NOTICE.txt</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
